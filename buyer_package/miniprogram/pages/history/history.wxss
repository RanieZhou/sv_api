/* pages/history/history.wxss */
page {
  background: #F4F6FB;
}

.history-container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 头部操作栏 */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.count-tip {
  font-size: 26rpx;
  color: #6B7280;
}

.clear-all-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #EF4444;
  padding: 10rpx 24rpx;
  background: #FEE2E2;
  border-radius: 20rpx;
  font-weight: 500;
}

/* 列表卡片 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  gap: 20rpx;
  transition: all 0.2s;
}

.history-card:active {
  transform: scale(0.99);
  background: #FAFAFA;
}

.cover-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 14rpx;
  background: #E5E7EB;
  flex-shrink: 0;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 130rpx;
}

.card-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.badge {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.badge-video {
  background: #EEF2FF;
  color: #4F46E5;
}

.badge-image {
  background: #FEF3C7;
  color: #D97706;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.card-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.author-name, .time-text {
  font-size: 22rpx;
  color: #9CA3AF;
}

.card-actions {
  display: flex;
  align-items: center;
}

.delete-btn {
  font-size: 24rpx;
  color: #9CA3AF;
  background: #F3F4F6;
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
  border: none;
  margin: 0;
  line-height: 1.4;
}

.delete-btn::after {
  border: none;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #374151;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #9CA3AF;
  margin-bottom: 40rpx;
}

.go-home-btn {
  background: linear-gradient(135deg, #4F46E5, #7C3AED);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(79, 70, 229, 0.3);
}
.go-home-btn::after {
  border: none;
}
