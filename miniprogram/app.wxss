/** app.wxss - 全局高颜值深色主题样式 **/
page {
  background-color: #0f172a;
  color: #f8fafc;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  box-sizing: border-box;
  font-size: 28rpx;
}

/* 玻璃感卡片容器 */
.card {
  background: rgba(30, 41, 59, 0.75);
  backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

/* 渐变全宽按钮 */
.btn-primary {
  background: linear-gradient(135deg, #06b6d4, #6366f1);
  color: #ffffff;
  font-weight: 600;
  font-size: 32rpx;
  border-radius: 20rpx;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 10rpx 30rpx rgba(6, 182, 212, 0.3);
  border: none;
}
.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.08);
  color: #06b6d4;
  border: 1rpx solid rgba(6, 182, 212, 0.3);
  border-radius: 16rpx;
  padding: 16rpx 30rpx;
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
}

/* 徽章 */
.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  background: rgba(6, 182, 212, 0.15);
  color: #22d3ee;
  border: 1rpx solid rgba(6, 182, 212, 0.3);
}

.text-muted {
  color: #94a3b8;
}
