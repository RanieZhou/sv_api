/** app.wxss - 柔和白+天空蓝主题全局样式 **/
page {
  background-color: #f8fafc;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  box-sizing: border-box;
  font-size: 28rpx;
}

/* 软糯白卡片 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(14, 165, 233, 0.06);
  border: 1rpx solid #e2e8f0;
}

/* 天空蓝主按钮 */
.btn-primary {
  background: linear-gradient(135deg, #38bdf8, #0284c7);
  color: #ffffff;
  font-weight: 600;
  font-size: 30rpx;
  border-radius: 20rpx;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(14, 165, 233, 0.25);
  border: none;
}
.btn-primary:active {
  opacity: 0.88;
  transform: scale(0.98);
}

.btn-secondary {
  background: #f0f9ff;
  color: #0284c7;
  border: 1rpx solid #bae6fd;
  border-radius: 18rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
}

/* 徽章 */
.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  background: #e0f2fe;
  color: #0369a1;
  border: 1rpx solid #bae6fd;
}

.text-muted {
  color: #64748b;
}

/* 容器通用间距 */
.container {
  box-sizing: border-box;
  width: 100%;
}
