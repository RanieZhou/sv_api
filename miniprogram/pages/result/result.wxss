/* pages/result/result.wxss */
page { background: #F0F4FF; }

.page {
  min-height: 100vh;
  padding: 20rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* ===== 顶部重新解析卡片 ===== */
.top-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(74,126,230,0.10);
}
.input-wrap {
  background: #F6F8FF;
  border-radius: 14rpx;
  border: 2rpx solid #DDE6FF;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.url-textarea {
  width: 100%;
  min-height: 100rpx;
  font-size: 27rpx;
  color: #2C3E50;
  line-height: 1.6;
  box-sizing: border-box;
}
.textarea-ph { color: #B0BCD0; font-size: 27rpx; }

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.sm-btn {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
  border-radius: 10rpx;
  border: none;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sm-btn::after { border: none; }
.paste-btn { background: #E8F0FF; color: #4A7EE6; }
.clear-btn  { background: #FFF0F0; color: #E06060; }

.extract-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #4A7EE6, #6B5BEF);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 14rpx;
  border: none;
  margin: 0;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 20rpx rgba(74,126,230,0.30);
}
.extract-btn::after { border: none; }
.extract-btn.disabled { background: #C5CDE6; box-shadow: none; }

/* ===== 加载中 ===== */
.loading-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 24rpx;
}
.loading-spin {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #DDE6FF;
  border-top-color: #4A7EE6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-txt { font-size: 28rpx; color: #8A9BB5; }

/* ===== 结果卡片 ===== */
.result-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(74,126,230,0.10);
}

/* 作者栏 */
.author-bar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #F0F4FF;
}
.author-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #DDE6FF;
  flex-shrink: 0;
}
.author-meta { flex: 1; overflow: hidden; }
.author-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A2340;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.author-fans { font-size: 22rpx; color: #8A9BB5; margin-top: 4rpx; display: block; }
.type-badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 18rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
}
.badge-vid { background: linear-gradient(135deg,#667eea,#764ba2); color:#fff; }
.badge-img { background: linear-gradient(135deg,#f093fb,#f5576c); color:#fff; }

/* ===== Tab 栏 ===== */
.tab-bar {
  display: flex;
  background: #F6F8FF;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #E8EEFF;
}
.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 88rpx;
  font-size: 28rpx;
  color: #8A9BB5;
  font-weight: 500;
  position: relative;
  transition: color 0.2s;
}
.tab-item.active {
  color: #4A7EE6;
  font-weight: 700;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  width: 60%;
  height: 4rpx;
  background: linear-gradient(90deg,#4A7EE6,#6B5BEF);
  border-radius: 2rpx;
}
.tab-count {
  background: #4A7EE6;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
}
.tab-item.active .tab-count { background: #4A7EE6; }

/* ===== Tab 内容区 ===== */
.tab-content { padding: 24rpx 28rpx; }

/* 视频播放器 */
.video-wrap { margin-bottom: 20rpx; }
.video-player {
  width: 100%;
  height: 430rpx;
  border-radius: 14rpx;
  background: #000;
  display: block;
}
.video-meta-row {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}
.meta-tag {
  background: #F0F4FF;
  color: #4A7EE6;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 封面备用 */
.cover-wrap {
  position: relative;
  height: 400rpx;
  border-radius: 14rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  background: #000;
}
.cover-img { width: 100%; height: 100%; }
.play-mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,0.25);
}
.play-icon { font-size: 72rpx; }

/* 互动数据 */
.stats-row {
  display: flex;
  background: linear-gradient(135deg,#f8f9ff,#f0f4ff);
  border-radius: 14rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #E8EEFF;
}
.stat-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.stat-num { font-size: 30rpx; font-weight: 700; color: #1A2340; }
.stat-lbl { font-size: 20rpx; color: #8A9BB5; }

/* 操作按钮 */
.action-btns { display: flex; gap: 16rpx; margin-top: 4rpx; }
.save-btn {
  flex: 1.5;
  background: linear-gradient(135deg,#52C41A,#3DA110);
  color: #fff;
  border-radius: 14rpx;
  border: none;
  font-size: 27rpx;
  font-weight: 600;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 0;
  box-shadow: 0 6rpx 16rpx rgba(82,196,26,0.25);
}
.save-btn::after { border: none; }
.save-btn.full-btn { flex: 1; }
.copy-btn {
  flex: 1;
  background: #4A7EE6;
  color: #fff;
  border-radius: 14rpx;
  border: none;
  font-size: 27rpx;
  font-weight: 600;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 0;
}
.copy-btn::after { border: none; }
.btn-ico { font-size: 28rpx; }
.btn-txt { display: flex; flex-direction: column; align-items: flex-start; gap: 4rpx; }
.quality-sub { font-size: 20rpx; opacity: 0.85; font-weight: 400; }

/* 进度条 */
.progress-wrap { margin-top: 16rpx; }
.progress-info-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.progress-txt { font-size: 24rpx; color: #5A6B8A; }
.progress-pct { font-size: 24rpx; color: #4A7EE6; font-weight: 600; }
.progress-track {
  background: #E8EEFF;
  border-radius: 6rpx;
  height: 12rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg,#4A7EE6,#6B5BEF);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* ===== 图片 Tab ===== */
.gallery-swiper {
  width: 100%;
  height: 520rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #000;
}
.gallery-img { width: 100%; height: 100%; }
.gallery-tip {
  text-align: center;
  font-size: 24rpx;
  color: #8A9BB5;
  padding: 14rpx 0 20rpx;
}
.empty-hint {
  text-align: center;
  padding: 80rpx 0;
  color: #B0BCD0;
  font-size: 28rpx;
}

/* ===== 标题 Tab ===== */
.info-block {
  background: #F8FAFE;
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
}
.info-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.info-label {
  font-size: 24rpx;
  color: #8A9BB5;
  font-weight: 600;
  display: block;
  margin-bottom: 10rpx;
}
.info-body {
  font-size: 28rpx;
  color: #1A2340;
  line-height: 1.7;
  word-break: break-all;
}
.copy-mini-btn {
  background: #E8F0FF;
  color: #4A7EE6;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  border: none;
  margin: 0;
}
.copy-mini-btn::after { border: none; }

.tag-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 10rpx; }
.tag-chip {
  background: linear-gradient(135deg,#e8f4ff,#dbeeff);
  color: #4A7EE6;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  border: 1rpx solid #C8E0FF;
}

.music-block {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: linear-gradient(135deg,#fff8f0,#fff3e8);
  border: 1rpx solid #FFD8A8;
}
.music-ico { font-size: 44rpx; }
.music-detail { flex: 1; overflow: hidden; }
.music-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #E67E22;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}
.music-by { font-size: 22rpx; color: #A0856A; display: block; margin-top: 4rpx; }

.kv-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #EEF2FF;
}
.kv-row:last-child { border-bottom: none; }
.kv-key { font-size: 26rpx; color: #8A9BB5; min-width: 140rpx; }
.kv-val { font-size: 26rpx; color: #1A2340; flex: 1; }
.success-txt { color: #52C41A; font-weight: 600; }
