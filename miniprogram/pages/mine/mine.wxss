/* mine.wxss - 柔和白+天空蓝 */
.user-card {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 24rpx;
  padding: 36rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(14, 165, 233, 0.06);
}

/* 灰色默认头像 */
.default-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #e2e8f0;
  border: 2rpx solid #cbd5e1;
}

.avatar-icon {
  font-size: 52rpx;
  color: #64748b;
}

.username {
  font-size: 32rpx;
  color: #0f172a;
  letter-spacing: 0.5rpx;
}

.userid-row {
  background: #f0f9ff;
  border: 1rpx solid #bae6fd;
  border-radius: 12rpx;
  padding: 4rpx 16rpx;
  display: inline-flex;
}

.userid-text {
  font-size: 22rpx;
  color: #0284c7;
  font-family: monospace;
  font-weight: 600;
}

.copy-btn-mini {
  font-size: 20rpx;
  color: #64748b;
  margin-left: 8rpx;
}

/* 4个独立堆叠的菜单卡片 */
.menu-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.menu-card {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100% !important;
  margin: 0;
  text-align: left;
  box-shadow: 0 4rpx 20rpx rgba(14, 165, 233, 0.04);
}

.menu-card:active {
  opacity: 0.88;
  transform: scale(0.99);
}

.menu-card-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #0f172a;
}

.item-icon-box {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.bg-sky {
  background: #e0f2fe;
  color: #0284c7;
  border: 1rpx solid #bae6fd;
}

.bg-blue {
  background: #dbeafe;
  color: #1d4ed8;
  border: 1rpx solid #bfdbfe;
}

.bg-indigo {
  background: #e0e7ff;
  color: #4338ca;
  border: 1rpx solid #c7d2fe;
}

.bg-purple {
  background: #f3e8ff;
  color: #7e22ce;
  border: 1rpx solid #e9d5ff;
}

.arrow {
  color: #94a3b8;
  font-size: 32rpx;
}

.btn-reset {
  line-height: normal;
  font-weight: normal;
}
.btn-reset::after {
  border: none;
}
