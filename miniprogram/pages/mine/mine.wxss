/* mine.wxss */
.avatar-box {
  width: 90rpx;
  height: 90rpx;
  background: linear-gradient(135deg, #06b6d4, #6366f1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-icon {
  font-size: 40rpx;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 30rpx;
  background: transparent;
}
.list-item.border-t {
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.btn-reset {
  margin: 0 !important;
  width: 100% !important;
  font-weight: normal;
  text-align: left;
  border-radius: 0;
}

.item-icon {
  font-size: 32rpx;
}
.arrow {
  color: #64748b;
  font-size: 28rpx;
}

.disclaimer-box {
  margin-top: 60rpx;
}
