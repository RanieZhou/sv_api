/* mine.wxss */
.user-card {
  background: rgba(30, 41, 59, 0.75);
  backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 36rpx 30rpx;
}

/* 灰色默认头像 */
.default-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #334155;
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.avatar-icon {
  font-size: 52rpx;
  color: #94a3b8;
}

.username {
  font-size: 32rpx;
  letter-spacing: 0.5rpx;
}

.userid-row {
  background: rgba(15, 23, 42, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 10rpx;
  padding: 4rpx 14rpx;
  display: inline-flex;
}

.userid-text {
  font-size: 22rpx;
  color: #38bdf8;
  font-family: monospace;
}

.copy-btn-mini {
  font-size: 20rpx;
  color: #94a3b8;
  margin-left: 8rpx;
}

/* 4个独立堆叠的菜单卡片 (草图布局) */
.menu-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.menu-card {
  background: rgba(30, 41, 59, 0.75);
  backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100% !important;
  margin: 0;
  text-align: left;
}

.menu-card:active {
  opacity: 0.85;
  transform: scale(0.99);
}

.menu-card-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #ffffff;
}

.item-icon-box {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.bg-cyan {
  background: rgba(6, 182, 212, 0.2);
  border: 1rpx solid rgba(6, 182, 212, 0.3);
}

.bg-emerald {
  background: rgba(16, 185, 129, 0.2);
  border: 1rpx solid rgba(16, 185, 129, 0.3);
}

.bg-indigo {
  background: rgba(99, 102, 241, 0.2);
  border: 1rpx solid rgba(99, 102, 241, 0.3);
}

.bg-purple {
  background: rgba(168, 85, 247, 0.2);
  border: 1rpx solid rgba(168, 85, 247, 0.3);
}

.arrow {
  color: #64748b;
  font-size: 32rpx;
}

.btn-reset {
  line-height: normal;
  font-weight: normal;
}
.btn-reset::after {
  border: none;
}
