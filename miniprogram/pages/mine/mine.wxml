<view class="container px-4 py-4">

  <!-- 1. 用户信息头部 (软糯白+天空蓝配色) -->
  <view class="user-card flex items-center justify-between mb-4">
    <view class="flex items-center gap-3">
      <!-- 灰色默认头像 -->
      <view class="default-avatar flex items-center justify-center">
        <text class="avatar-icon">👤</text>
      </view>
      <view class="user-info flex flex-col justify-center">
        <!-- 固定用户名 -->
        <view class="username text-base font-bold text-slate-900 mb-1">短视频聚合解析工具</view>
        <!-- 随机分配的 8 位字母数字 ID -->
        <view class="userid-row flex items-center gap-1" bindtap="copyUserId">
          <text class="userid-text">ID : {{userId}}</text>
          <text class="copy-btn-mini">复制</text>
        </view>
      </view>
    </view>
    <view class="badge">今日已用 {{usedToday}} 次</view>
  </view>

  <!-- 2. 四大独立堆叠卡片菜单 -->
  <view class="menu-stack">
    <!-- 历史记录 -->
    <view class="menu-card" bindtap="openHistoryModal">
      <view class="flex items-center gap-3">
        <view class="item-icon-box bg-sky">📜</view>
        <text class="menu-card-title">历史记录</text>
      </view>
      <text class="arrow">▸</text>
    </view>

    <!-- 卡密兑换 -->
    <view class="menu-card" bindtap="openRedeemModal">
      <view class="flex items-center gap-3">
        <view class="item-icon-box bg-blue">🔑</view>
        <text class="menu-card-title">卡密兑换</text>
      </view>
      <text class="arrow">▸</text>
    </view>

    <!-- 联系客服 -->
    <button class="menu-card btn-reset" open-type="contact">
      <view class="flex items-center gap-3">
        <view class="item-icon-box bg-indigo">💬</view>
        <text class="menu-card-title">联系客服</text>
      </view>
      <text class="arrow">▸</text>
    </button>

    <!-- 建议反馈 -->
    <button class="menu-card btn-reset" open-type="feedback">
      <view class="flex items-center gap-3">
        <view class="item-icon-box bg-purple">📝</view>
        <text class="menu-card-title">建议反馈</text>
      </view>
      <text class="arrow">▸</text>
    </button>
  </view>

  <!-- 免责声明 -->
  <view class="disclaimer-box text-center mt-6">
    <view class="text-xs text-slate-400 mb-1">免责声明</view>
    <view class="text-[20rpx] text-slate-500 leading-relaxed px-4">
      {{config.disclaimer || '本小程序仅提供技术解析工具，素材版权均归原平台及创作人所有。分配随机ID作为唯一标识，无需微信账号登录。'}}
    </view>
  </view>

</view>
