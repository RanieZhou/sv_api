<view class="container px-4 py-4">

  <!-- 1. 用户信息头部卡片 -->
  <view class="user-card flex items-center justify-between mb-4">
    <view class="flex items-center gap-3">
      <!-- 灰色默认头像 -->
      <view class="default-avatar flex items-center justify-center">
        <text class="avatar-icon">👤</text>
      </view>
      <view class="user-info flex flex-col justify-center">
        <!-- 固定用户名 -->
        <view class="username text-base font-bold text-white mb-1">短视频聚合解析工具</view>
        <!-- 随机分配的 8 位字母数字 ID (用于标识/代替登录) -->
        <view class="userid-row flex items-center gap-1" bindtap="copyUserId">
          <text class="userid-text">ID: {{userId}}</text>
          <text class="copy-btn-mini">复制</text>
        </view>
      </view>
    </view>
    <view class="badge">今日已用 {{usedToday}} 次</view>
  </view>

  <!-- 2. 功能菜单列表 -->
  <view class="card p-0 overflow-hidden mb-4">
    <!-- 联系客服 -->
    <button class="list-item btn-reset flex items-center justify-between" open-type="contact">
      <view class="flex items-center gap-3">
        <view class="item-icon-box bg-cyan">💬</view>
        <text class="text-sm text-white font-medium">联系客服</text>
      </view>
      <text class="arrow">▸</text>
    </button>

    <!-- 建议反馈 -->
    <button class="list-item border-t btn-reset flex items-center justify-between" open-type="feedback">
      <view class="flex items-center gap-3">
        <view class="item-icon-box bg-indigo">📝</view>
        <text class="text-sm text-white font-medium">建议反馈</text>
      </view>
      <text class="arrow">▸</text>
    </button>
  </view>

  <!-- 3. 免责声明 -->
  <view class="disclaimer-box text-center mt-6">
    <view class="text-xs text-slate-500 mb-1">免责声明</view>
    <view class="text-[20rpx] text-slate-600 leading-relaxed px-4">
      {{config.disclaimer || '本小程序仅提供技术解析工具，素材版权均归原平台及创作人所有。分配随机ID作为唯一标识，无需微信账号登录。'}}
    </view>
  </view>

</view>
