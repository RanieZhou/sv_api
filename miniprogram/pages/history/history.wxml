<!-- 解析历史记录页 -->
<view class="history-container">

  <!-- 顶部操作栏 -->
  <view class="header-bar" wx:if="{{historyList.length > 0}}">
    <text class="count-tip">共 {{historyList.length}} 条解析记录</text>
    <view class="clear-all-btn" bindtap="clearAllHistory">
      <text class="clear-icon">🗑️</text>
      <text>清空全部</text>
    </view>
  </view>

  <!-- 历史记录列表 -->
  <view class="history-list" wx:if="{{historyList.length > 0}}">
    <view class="history-card" wx:for="{{historyList}}" wx:key="id" bindtap="onItemTap" data-index="{{index}}">
      <image class="cover-image" src="{{item.proxyCover || item.cover || '/assets/default_cover.png'}}" mode="aspectFill"></image>
      <view class="card-info">
        <view class="card-title-row">
          <text class="badge {{item.type === 'images' ? 'badge-image' : 'badge-video'}}">
            {{item.type === 'images' ? '图集' : '视频'}}
          </text>
          <text class="card-title">{{item.title}}</text>
        </view>
        <view class="card-meta">
          <text class="author-name">👤 {{item.author}}</text>
          <text class="time-text">🕒 {{item.time}}</text>
        </view>
      </view>
      <view class="card-actions">
        <button class="action-btn delete-btn" catchtap="deleteItem" data-index="{{index}}">删除</button>
      </view>
    </view>
  </view>

  <!-- 暂无记录空状态 -->
  <view class="empty-state" wx:else>
    <text class="empty-icon">📜</text>
    <text class="empty-title">暂无解析历史</text>
    <text class="empty-desc">解析后的视频和图集记录会自动保存在这里</text>
    <button class="go-home-btn" bindtap="goHome">去解析视频</button>
  </view>

</view>
