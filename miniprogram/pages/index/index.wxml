<!-- 首页 -->
<view class="container">

  <!-- 轮播图 -->
  <view class="banner-section" wx:if="{{showBanners && banners.length > 0}}">
    <swiper class="banner-swiper" indicator-dots="{{true}}" autoplay="{{true}}" interval="{{3000}}" duration="{{500}}" circular="{{true}}">
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <image class="banner-image" src="{{item.imageUrl}}" mode="aspectFill" bindtap="onBannerTap" data-url="{{item.linkUrl}}"></image>
      </swiper-item>
    </swiper>
  </view>

  <!-- 主解析卡片 -->
  <view class="parse-card">
    <view class="card-header">
      <text class="card-title">🎬 短视频去水印</text>
      <text class="card-sub">支持抖音、快手、西瓜等平台</text>
    </view>

    <!-- 文本输入框 -->
    <view class="input-wrap">
      <textarea
        class="url-textarea"
        placeholder="粘贴视频链接或分享文字，系统自动识别"
        placeholder-class="textarea-placeholder"
        value="{{inputUrl}}"
        bindinput="onUrlInput"
        auto-height
        maxlength="2000"
      ></textarea>
    </view>

    <!-- 粘贴 / 清空 -->
    <view class="action-row">
      <button class="action-btn paste-btn" bindtap="pasteUrl">
        <text class="action-icon">📋</text>
        <text>粘贴内容</text>
      </button>
      <button class="action-btn clear-btn" bindtap="clearUrl">
        <text class="action-icon">🗑️</text>
        <text>清空内容</text>
      </button>
    </view>

    <!-- 开始提取 -->
    <button
      class="extract-btn {{!canParse ? 'disabled' : ''}}"
      bindtap="parseVideo"
      disabled="{{!canParse || isLoading}}"
      loading="{{isLoading}}"
    >
      {{isLoading ? '解析中...' : '开始提取'}}
    </button>
  </view>

  <!-- 功能特性 -->
  <view class="feature-section">
    <view class="feature-item">
      <text class="f-icon">🚫</text>
      <text class="f-name">去除水印</text>
    </view>
    <view class="feature-item">
      <text class="f-icon">⚡</text>
      <text class="f-name">秒级解析</text>
    </view>
    <view class="feature-item">
      <text class="f-icon">🎬</text>
      <text class="f-name">在线预览</text>
    </view>
    <view class="feature-item">
      <text class="f-icon">💾</text>
      <text class="f-name">一键保存</text>
    </view>
  </view>

</view>