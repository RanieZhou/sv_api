<view class="container px-4 py-3">

  <!-- 1. 轮播图 (左右留有空间) -->
  <view class="swiper-container mb-4">
    <view class="swiper-wrapper">
      <swiper class="banner-swiper" indicator-dots autoplay circular interval="4000" duration="500" indicator-color="rgba(255, 255, 255, 0.4)" indicator-active-color="#0284c7">
        <swiper-item wx:for="{{banners}}" wx:key="index">
          <view class="banner-item {{item.bgClass}} flex flex-col justify-center px-4">
            <view class="banner-badge mb-1">{{item.badge}}</view>
            <view class="banner-title text-lg font-bold text-white mb-1">{{item.title}}</view>
            <view class="banner-desc text-xs text-sky-100">{{item.desc}}</view>
          </view>
        </swiper-item>
      </swiper>
    </view>
  </view>

  <!-- 2. 文本框卡片 (已去除“粘贴文本框”标题和“今日可用次数”) -->
  <view class="card mb-4">
    <!-- 文本框 -->
    <textarea
      class="input-textarea"
      value="{{inputUrl}}"
      bindinput="onInputChange"
      placeholder="粘贴抖音、快手、小红书、B站等短视频或图集分享链接..."
      placeholder-class="placeholder-style"
      maxlength="500"
    ></textarea>

    <!-- 一键粘贴 与 开始提取 (完美水平对齐) -->
    <view class="button-group mt-3">
      <button class="btn-action-half secondary" bindtap="pasteClipboard">
        <text>📋 一键粘贴</text>
      </button>
      <button class="btn-action-half primary" bindtap="startParse" loading="{{loading}}">
        <text>{{loading ? '提取中...' : '🚀 开始提取'}}</text>
      </button>
    </view>
  </view>

  <!-- 3. 小组件区域: 使用教程 与 常见问题 (点击直接跳转到新页面，无弹窗) -->
  <view class="widget-grid-2 mb-4">
    <view class="widget-card-large" bindtap="openTutorialPage">
      <view class="widget-icon-large bg-sky">📖</view>
      <view class="widget-title-large">使用教程</view>
      <view class="widget-desc-large">三步快速上手去水印</view>
    </view>

    <view class="widget-card-large" bindtap="openFaqPage">
      <view class="widget-icon-large bg-blue">💡</view>
      <view class="widget-title-large">常见问题</view>
      <view class="widget-desc-large">解答与故障处理指南</view>
    </view>
  </view>

  <!-- 4. 解析结果展示 -->
  <view class="card result-card" wx:if="{{hasResult}}">
    <view class="text-sm font-semibold text-slate-800 mb-3 flex items-center justify-between">
      <text>🎉 解析结果</text>
      <text class="text-xs text-slate-500" wx:if="{{resultData.author && resultData.author.name}}">作者: {{resultData.author.name}}</text>
    </view>

    <!-- 标题与描述 -->
    <view class="mb-3" wx:if="{{resultData.title || resultData.desc}}">
      <view class="result-desc">
        {{resultData.title || resultData.desc}}
      </view>
    </view>

    <!-- 视频预览与下载 -->
    <block wx:if="{{videoUrl}}">
      <view class="video-wrapper mb-3">
        <video class="video-player" src="{{videoUrl}}" controls preload="metadata"></video>
      </view>

      <view class="flex flex-col gap-2 mb-3">
        <button class="btn-action primary mb-2" bindtap="saveVideo">
          <text>📥 保存无水印视频到相册</text>
        </button>
        <button class="btn-action secondary" bindtap="copyLink">
          <text>🔗 复制无水印直链</text>
        </button>
      </view>
    </block>

    <!-- 图集预览与下载 -->
    <block wx:if="{{imageList.length > 0}}">
      <view class="text-xs text-sky-600 mb-2 font-semibold">高清图集 (共 {{imageList.length}} 张)</view>
      <view class="image-grid mb-3">
        <block wx:for="{{imageList}}" wx:key="index">
          <image class="grid-img" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-src="{{item}}"></image>
        </block>
      </view>
      <button class="btn-action primary mb-2" bindtap="saveAllImages">
        <text>🖼️ 保存全部高清图集到相册</text>
      </button>
    </block>
  </view>

</view>
