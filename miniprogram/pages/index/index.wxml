<view class="container px-4 py-3">

  <!-- 1. 轮播图区域 -->
  <view class="swiper-wrapper mb-3">
    <swiper class="banner-swiper" indicator-dots autoplay circular interval="4000" duration="500" indicator-color="rgba(255, 255, 255, 0.3)" indicator-active-color="#06b6d4">
      <swiper-item wx:for="{{banners}}" wx:key="index">
        <view class="banner-item {{item.bgClass}} flex flex-col justify-center px-4">
          <view class="banner-badge mb-1">{{item.badge}}</view>
          <view class="banner-title text-lg font-bold text-white mb-1">{{item.title}}</view>
          <view class="banner-desc text-xs text-slate-200">{{item.desc}}</view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 2. 解析文本框卡片 -->
  <view class="card">
    <view class="flex items-center justify-between mb-3">
      <view class="text-sm font-semibold text-white">粘贴视频/图集链接</view>
      <view class="badge">今日可用: {{remainingQuota}} 次</view>
    </view>

    <!-- 文本框 -->
    <textarea
      class="input-textarea"
      value="{{inputUrl}}"
      bindinput="onInputChange"
      placeholder="粘贴抖音、快手、小红书、B站等App复制的完整分享文字..."
      placeholder-class="placeholder-style"
      maxlength="500"
    ></textarea>

    <!-- 操作工具按钮 -->
    <view class="flex items-center justify-between mt-3 mb-4">
      <button class="btn-tool" bindtap="pasteClipboard">
        <text>📋 一键粘贴</text>
      </button>
      <button class="btn-tool" bindtap="clearInput">
        <text>🗑️ 清空内容</text>
      </button>
    </view>

    <!-- 解析主按钮：开始提取 -->
    <button class="btn-primary" bindtap="startParse" loading="{{loading}}">
      {{loading ? '正在提取中...' : '开始提取'}}
    </button>
  </view>

  <!-- 3. 小组件区域 -->
  <view class="widget-grid mb-3">
    <view class="widget-card" bindtap="openTutorialModal">
      <view class="widget-icon bg-cyan">📖</view>
      <view class="widget-info">
        <view class="widget-title">使用教程</view>
        <view class="widget-sub">三步极速提取</view>
      </view>
    </view>

    <button class="widget-card btn-reset" open-type="share">
      <view class="widget-icon bg-indigo">🎁</view>
      <view class="widget-info">
        <view class="widget-title">邀请好友</view>
        <view class="widget-sub">分享助手给朋友</view>
      </view>
    </button>

    <view class="widget-card" bindtap="openFaqModal">
      <view class="widget-icon bg-emerald">💡</view>
      <view class="widget-info">
        <view class="widget-title">常见问题</view>
        <view class="widget-sub">常见疑问解答</view>
      </view>
    </view>
  </view>

  <!-- 4. 解析结果展示区域 -->
  <view class="card result-card" wx:if="{{hasResult}}">
    <view class="text-sm font-semibold text-white mb-3 flex items-center justify-between">
      <text>🎉 解析结果</text>
      <text class="text-xs text-slate-400" wx:if="{{resultData.author && resultData.author.name}}">作者: {{resultData.author.name}}</text>
    </view>

    <!-- 标题与描述 -->
    <view class="mb-3" wx:if="{{resultData.title || resultData.desc}}">
      <view class="result-desc">
        {{resultData.title || resultData.desc}}
      </view>
    </view>

    <!-- 视频预览与下载 -->
    <block wx:if="{{videoUrl}}">
      <view class="video-wrapper mb-3">
        <video class="video-player" src="{{videoUrl}}" controls preload="metadata"></video>
      </view>

      <view class="grid-actions mb-3">
        <button class="btn-action primary mb-2" bindtap="saveVideo">
          <text>📥 保存无水印视频到相册</text>
        </button>
        <button class="btn-action secondary" bindtap="copyLink">
          <text>🔗 复制无水印直链</text>
        </button>
      </view>
    </block>

    <!-- 图集预览与下载 -->
    <block wx:if="{{imageList.length > 0}}">
      <view class="text-xs text-cyan-400 mb-2 font-semibold">高清图集 (共 {{imageList.length}} 张)</view>
      <view class="image-grid mb-3">
        <block wx:for="{{imageList}}" wx:key="index">
          <image class="grid-img" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-src="{{item}}"></image>
        </block>
      </view>
      <button class="btn-action primary mb-2" bindtap="saveAllImages">
        <text>🖼️ 保存全部高清图集到相册</text>
      </button>
    </block>
  </view>

  <!-- 流量主 Banner 广告位 -->
  <view class="my-3" wx:if="{{config.ad_banner_id}}">
    <ad unit-id="{{config.ad_banner_id}}"></ad>
  </view>

</view>
