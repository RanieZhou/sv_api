/* index.wxss */
.swiper-wrapper {
  width: 100%;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.3);
}

.banner-swiper {
  width: 100%;
  height: 220rpx;
}

.banner-item {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  position: relative;
}

.bg-gradient-1 {
  background: linear-gradient(135deg, #0284c7, #6366f1);
}

.bg-gradient-2 {
  background: linear-gradient(135deg, #0d9488, #2563eb);
}

.bg-gradient-3 {
  background: linear-gradient(135deg, #4f46e5, #9333ea);
}

.banner-badge {
  display: inline-block;
  align-self: flex-start;
  font-size: 20rpx;
  font-weight: bold;
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(10px);
}

.banner-title {
  font-size: 32rpx;
  line-height: 1.3;
}

.banner-desc {
  opacity: 0.9;
  font-size: 24rpx;
}

/* 粘贴文本框 */
.input-textarea {
  width: 100%;
  height: 180rpx;
  background: rgba(15, 23, 42, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 26rpx;
  color: #ffffff;
  box-sizing: border-box;
  line-height: 1.5;
}

.placeholder-style {
  color: #64748b;
  font-size: 26rpx;
}

/* 并列两个按钮：一键粘贴 & 开始提取 */
.btn-action-half {
  flex: 1;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: bold;
  padding: 22rpx 0;
  text-align: center;
  margin: 0;
}

.btn-action-half.secondary {
  background: rgba(255, 255, 255, 0.08);
  color: #22d3ee;
  border: 1rpx solid rgba(6, 182, 212, 0.3);
}

.btn-action-half.primary {
  background: linear-gradient(135deg, #06b6d4, #6366f1);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(6, 182, 212, 0.3);
  border: none;
}

.btn-action-half:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 并列两个小组件: 使用教程 & 常见问题 */
.widget-grid-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.widget-card-large {
  background: rgba(30, 41, 59, 0.75);
  backdrop-filter: blur(15px);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
}

.widget-card-large:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.widget-icon-large {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 16rpx;
}

.bg-cyan {
  background: rgba(6, 182, 212, 0.2);
  border: 1rpx solid rgba(6, 182, 212, 0.3);
}

.bg-emerald {
  background: rgba(16, 185, 129, 0.2);
  border: 1rpx solid rgba(16, 185, 129, 0.3);
}

.widget-title-large {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 6rpx;
}

.widget-desc-large {
  font-size: 22rpx;
  color: #94a3b8;
}

/* 解析结果区域 */
.result-desc {
  background: rgba(15, 23, 42, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 24rpx;
  color: #cbd5e1;
  line-height: 1.6;
}

.video-wrapper {
  width: 100%;
  border-radius: 20rpx;
  overflow: hidden;
  background: #000000;
}

.video-player {
  width: 100%;
  height: 400rpx;
}

.btn-action {
  width: 100% !important;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: bold;
  padding: 22rpx 0;
  text-align: center;
}

.btn-action.primary {
  background: linear-gradient(135deg, #06b6d4, #3b82f6);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(6, 182, 212, 0.3);
}

.btn-action.secondary {
  background: rgba(255, 255, 255, 0.08);
  color: #22d3ee;
  border: 1rpx solid rgba(6, 182, 212, 0.3);
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.grid-img {
  width: 100%;
  height: 210rpx;
  border-radius: 16rpx;
  background: #1e293b;
}
