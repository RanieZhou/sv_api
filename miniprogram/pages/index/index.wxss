/* index.wxss */
.swiper-wrapper {
  width: 100%;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.3);
}

.banner-swiper {
  width: 100%;
  height: 220rpx;
}

.banner-item {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  position: relative;
}

.bg-gradient-1 {
  background: linear-gradient(135deg, #0284c7, #6366f1);
}

.bg-gradient-2 {
  background: linear-gradient(135deg, #0d9488, #2563eb);
}

.bg-gradient-3 {
  background: linear-gradient(135deg, #4f46e5, #9333ea);
}

.banner-badge {
  display: inline-block;
  align-self: flex-start;
  font-size: 20rpx;
  font-weight: bold;
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(10px);
}

.banner-title {
  font-size: 32rpx;
  line-height: 1.3;
}

.banner-desc {
  opacity: 0.9;
  font-size: 24rpx;
}

/* 输入框 */
.input-textarea {
  width: 100%;
  height: 180rpx;
  background: rgba(15, 23, 42, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 26rpx;
  color: #ffffff;
  box-sizing: border-box;
  line-height: 1.5;
}

.placeholder-style {
  color: #64748b;
  font-size: 26rpx;
}

.btn-tool {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: #cbd5e1;
  font-size: 24rpx;
  padding: 12rpx 28rpx;
  border-radius: 14rpx;
  margin: 0;
  line-height: 1.5;
}

/* 小组件 Widget 区域 */
.widget-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.widget-card {
  background: rgba(30, 41, 59, 0.75);
  backdrop-filter: blur(15px);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 20rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  margin: 0;
  box-sizing: border-box;
}

.widget-card:active {
  opacity: 0.8;
  transform: scale(0.97);
}

.widget-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 12rpx;
}

.bg-cyan {
  background: rgba(6, 182, 212, 0.2);
  border: 1rpx solid rgba(6, 182, 212, 0.3);
}

.bg-indigo {
  background: rgba(99, 102, 241, 0.2);
  border: 1rpx solid rgba(99, 102, 241, 0.3);
}

.bg-emerald {
  background: rgba(16, 185, 129, 0.2);
  border: 1rpx solid rgba(16, 185, 129, 0.3);
}

.widget-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 4rpx;
}

.widget-sub {
  font-size: 20rpx;
  color: #94a3b8;
}

.btn-reset {
  padding: 20rpx 12rpx;
  line-height: normal;
  background: rgba(30, 41, 59, 0.75);
  border-radius: 20rpx;
  font-weight: normal;
}
.btn-reset::after {
  border: none;
}

/* 结果区 */
.result-desc {
  background: rgba(15, 23, 42, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 24rpx;
  color: #cbd5e1;
  line-height: 1.6;
}

.video-wrapper {
  width: 100%;
  border-radius: 20rpx;
  overflow: hidden;
  background: #000000;
}

.video-player {
  width: 100%;
  height: 400rpx;
}

.btn-action {
  width: 100% !important;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: bold;
  padding: 22rpx 0;
  text-align: center;
}

.btn-action.primary {
  background: linear-gradient(135deg, #06b6d4, #3b82f6);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(6, 182, 212, 0.3);
}

.btn-action.secondary {
  background: rgba(255, 255, 255, 0.08);
  color: #22d3ee;
  border: 1rpx solid rgba(6, 182, 212, 0.3);
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.grid-img {
  width: 100%;
  height: 210rpx;
  border-radius: 16rpx;
  background: #1e293b;
}
