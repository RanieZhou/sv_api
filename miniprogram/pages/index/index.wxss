/* index.wxss - 柔和白+天空蓝主题 */
.swiper-container {
  width: 100%;
  box-sizing: border-box;
  padding: 0 4rpx;
}

.swiper-wrapper {
  width: 100%;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(14, 165, 233, 0.15);
}

.banner-swiper {
  width: 100%;
  height: 230rpx;
}

.banner-item {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  position: relative;
}

/* 天空蓝与柔和渐变 */
.bg-gradient-1 {
  background: linear-gradient(135deg, #0ea5e9, #0284c7);
}

.bg-gradient-2 {
  background: linear-gradient(135deg, #38bdf8, #2563eb);
}

.bg-gradient-3 {
  background: linear-gradient(135deg, #0284c7, #4f46e5);
}

.banner-badge {
  display: inline-block;
  align-self: flex-start;
  font-size: 20rpx;
  font-weight: bold;
  background: rgba(255, 255, 255, 0.25);
  color: #ffffff;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(10px);
}

.banner-title {
  font-size: 32rpx;
  line-height: 1.3;
}

.banner-desc {
  opacity: 0.95;
  font-size: 24rpx;
}

/* 粘贴文本框 */
.input-textarea {
  width: 100%;
  height: 200rpx;
  background: #f8fafc;
  border: 1.5rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 26rpx;
  color: #0f172a;
  box-sizing: border-box;
  line-height: 1.5;
}

.input-textarea:focus {
  border-color: #38bdf8;
  background: #ffffff;
}

.placeholder-style {
  color: #94a3b8;
  font-size: 26rpx;
}

/* 水平并列双按钮容器 */
.button-group {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  width: 100%;
}

.btn-action-half {
  flex: 1;
  width: 50% !important;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 22rpx 0;
  text-align: center;
  margin: 0;
  box-sizing: border-box;
}

.btn-action-half.secondary {
  background: #f0f9ff;
  color: #0284c7;
  border: 1.5rpx solid #bae6fd;
}

.btn-action-half.primary {
  background: linear-gradient(135deg, #38bdf8, #0284c7);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(14, 165, 233, 0.25);
  border: none;
}

.btn-action-half:active {
  opacity: 0.88;
  transform: scale(0.98);
}

/* 小组件 2 栏布局 */
.widget-grid-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.widget-card-large {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 20rpx rgba(14, 165, 233, 0.06);
  border-radius: 24rpx;
  padding: 32rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
}

.widget-card-large:active {
  opacity: 0.88;
  transform: scale(0.98);
}

.widget-icon-large {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 16rpx;
}

.bg-sky {
  background: #e0f2fe;
  color: #0284c7;
  border: 1rpx solid #bae6fd;
}

.bg-blue {
  background: #dbeafe;
  color: #1d4ed8;
  border: 1rpx solid #bfdbfe;
}

.widget-title-large {
  font-size: 28rpx;
  font-weight: bold;
  color: #0f172a;
  margin-bottom: 6rpx;
}

.widget-desc-large {
  font-size: 22rpx;
  color: #64748b;
}

/* 解析结果区 */
.result-desc {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 24rpx;
  color: #334155;
  line-height: 1.6;
}

.video-wrapper {
  width: 100%;
  border-radius: 20rpx;
  overflow: hidden;
  background: #000000;
}

.video-player {
  width: 100%;
  height: 400rpx;
}

.btn-action {
  width: 100% !important;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: bold;
  padding: 22rpx 0;
  text-align: center;
}

.btn-action.primary {
  background: linear-gradient(135deg, #0ea5e9, #0284c7);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(14, 165, 233, 0.25);
  border: none;
}

.btn-action.secondary {
  background: #f0f9ff;
  color: #0284c7;
  border: 1rpx solid #bae6fd;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.grid-img {
  width: 100%;
  height: 210rpx;
  border-radius: 16rpx;
  background: #e2e8f0;
}
