/* pages/index/index.wxss */
page {
  background: #F0F4FF;
}

.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 轮播图 */
.banner-section {
  margin: 20rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(74,144,226,0.12);
}
.banner-swiper { height: 300rpx; }
.banner-image { width: 100%; height: 100%; }

/* 主解析卡片 */
.parse-card {
  margin: 24rpx 24rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(74,144,226,0.10);
}

.card-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}
.card-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A2340;
  letter-spacing: 1rpx;
}
.card-sub {
  font-size: 24rpx;
  color: #8A9BB5;
  margin-top: 8rpx;
}

/* 文本输入框 */
.input-wrap {
  background: #F6F8FF;
  border-radius: 16rpx;
  border: 2rpx solid #DDE6FF;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.url-textarea {
  width: 100%;
  min-height: 140rpx;
  font-size: 28rpx;
  color: #2C3E50;
  line-height: 1.6;
  box-sizing: border-box;
}
.textarea-placeholder {
  color: #B0BCD0;
  font-size: 27rpx;
}

/* 粘贴 / 清空 行 */
.action-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  margin: 0;
}
.paste-btn {
  background: #E8F0FF;
  color: #4A7EE6;
}
.paste-btn::after { border: none; }
.clear-btn {
  background: #FFF0F0;
  color: #E06060;
}
.clear-btn::after { border: none; }
.action-icon { font-size: 30rpx; }

/* 开始提取按钮 */
.extract-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #4A7EE6, #6B5BEF);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 16rpx;
  border: none;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(74,126,230,0.35);
  transition: all 0.2s;
  margin: 0;
}
.extract-btn::after { border: none; }
.extract-btn.disabled {
  background: #C5CDE6;
  box-shadow: none;
  color: #fff;
}
.extract-btn:active:not(.disabled) {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(74,126,230,0.25);
}

/* 功能特性 */
.feature-section {
  display: flex;
  justify-content: space-around;
  margin: 0 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(74,144,226,0.07);
}
.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.f-icon { font-size: 44rpx; }
.f-name {
  font-size: 24rpx;
  color: #5A6B8A;
  font-weight: 500;
}