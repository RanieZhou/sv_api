/* pages/index/index.wxss */
page {
  background: #F0F4FF;
}

.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 轮播图 */
.banner-section {
  margin: 20rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(74,144,226,0.12);
}
.banner-swiper { height: 300rpx; }
.banner-image { width: 100%; height: 100%; }

/* 滚动通知栏 */
.notice-section {
  margin: 16rpx 24rpx 0;
}
.notice-bar {
  display: flex;
  align-items: center;
  background: #FFFBE6;
  border: 1rpx solid #FFE58F;
  border-radius: 16rpx;
  padding: 14rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(255,197,61,0.12);
}
.notice-icon {
  font-size: 30rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.notice-content {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  position: relative;
}
.notice-text {
  display: inline-block;
  font-size: 26rpx;
  color: #D46B08;
  white-space: nowrap;
  animation: noticeScroll 14s linear infinite;
  padding-left: 100%;
}

@keyframes noticeScroll {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-100%);
  }
}

/* 主解析卡片 */
.parse-card {
  margin: 24rpx 24rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(74,144,226,0.10);
}

.card-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}
.card-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A2340;
  letter-spacing: 1rpx;
}
.card-sub {
  font-size: 24rpx;
  color: #8A9BB5;
  margin-top: 8rpx;
}

/* 文本输入框 */
.input-wrap {
  background: #F6F8FF;
  border-radius: 16rpx;
  border: 2rpx solid #DDE6FF;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.url-textarea {
  width: 100%;
  min-height: 140rpx;
  font-size: 28rpx;
  color: #2C3E50;
  line-height: 1.6;
  box-sizing: border-box;
}
.textarea-placeholder {
  color: #B0BCD0;
  font-size: 27rpx;
}

/* 粘贴 / 清空 行 */
.action-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  margin: 0;
}
.paste-btn {
  background: #E8F0FF;
  color: #4A7EE6;
}
.paste-btn::after { border: none; }
.clear-btn {
  background: #FFF0F0;
  color: #E06060;
}
.clear-btn::after { border: none; }
.action-icon { font-size: 30rpx; }

/* 开始提取按钮 */
.extract-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #4A7EE6, #6B5BEF);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 16rpx;
  border: none;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(74,126,230,0.35);
  transition: all 0.2s;
  margin: 0;
}
.extract-btn::after { border: none; }
.extract-btn.disabled {
  background: #C5CDE6;
  box-shadow: none;
  color: #fff;
}
.extract-btn:active:not(.disabled) {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(74,126,230,0.25);
}

/* 使用教程 & 常见问题 公用容器 */
.guide-section, .faq-section {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(74,144,226,0.08);
}

.guide-badge-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 8rpx;
}

.guide-badge {
  background: #FFF7E6;
  color: #FA8C16;
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
  letter-spacing: 1rpx;
}

.section-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  letter-spacing: 1rpx;
}

/* 竖直流程图 */
.guide-steps {
  display: flex;
  flex-direction: column;
  padding: 0 10rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.step-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #7C4DFF, #651FFF);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(124, 77, 255, 0.3);
  flex-shrink: 0;
}

.step-icon {
  font-size: 36rpx;
  color: #fff;
}

.step-info {
  flex: 1;
  padding-top: 4rpx;
}

.step-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  display: block;
  margin-bottom: 8rpx;
}

.step-desc {
  font-size: 25rpx;
  color: #6B7280;
  line-height: 1.5;
  display: block;
}

.step-line {
  width: 4rpx;
  height: 36rpx;
  background: #E5E7EB;
  margin: 10rpx 0 10rpx 38rpx;
}

/* 常见问题 (手风琴) */
.faq-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.faq-item {
  background: #F9FAFB;
  border: 1rpx solid #F3F4F6;
  border-radius: 16rpx;
  overflow: hidden;
  transition: all 0.2s;
}

.faq-item.expanded {
  background: #FFFFFF;
  border-color: #E5E7EB;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.faq-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.faq-question {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  flex: 1;
  padding-right: 16rpx;
}

.faq-arrow {
  font-size: 22rpx;
  color: #9CA3AF;
}

.faq-body {
  padding: 0 28rpx 24rpx 28rpx;
  border-top: 1rpx solid #F3F4F6;
  margin-top: 4rpx;
  padding-top: 16rpx;
}

.faq-answer {
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.6;
  display: block;
}