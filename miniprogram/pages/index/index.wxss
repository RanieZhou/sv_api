/* index.wxss */
.notice-bar {
  background: rgba(6, 182, 212, 0.1);
  border: 1rpx solid rgba(6, 182, 212, 0.25);
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
}
.notice-tag {
  background: #06b6d4;
  color: #0f172a;
  font-size: 20rpx;
  font-weight: bold;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}
.notice-text {
  font-size: 24rpx;
  color: #22d3ee;
}

.input-textarea {
  width: 100%;
  height: 160rpx;
  background: rgba(15, 23, 42, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #ffffff;
  box-sizing: border-box;
}

.placeholder-style {
  color: #64748b;
  font-size: 26rpx;
}

.btn-tool {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: #cbd5e1;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  margin: 0;
}

.video-wrapper {
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  background: #000000;
}
.video-player {
  width: 100%;
  height: 380rpx;
}

.btn-action {
  width: 100% !important;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: bold;
  padding: 20rpx 0;
  text-align: center;
}
.btn-action.primary {
  background: #06b6d4;
  color: #0f172a;
}
.btn-action.secondary {
  background: rgba(255, 255, 255, 0.08);
  color: #22d3ee;
  border: 1rpx solid rgba(6, 182, 212, 0.3);
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}
.grid-img {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #1e293b;
}
