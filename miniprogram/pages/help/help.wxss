/* help.wxss */
.platform-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.chip {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: #cbd5e1;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
}

.step-item {
  display: flex;
  gap: 20rpx;
}
.step-number {
  width: 48rpx;
  height: 48rpx;
  background: #06b6d4;
  color: #0f172a;
  border-radius: 50%;
  font-weight: bold;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.step-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 6rpx;
}
.step-desc {
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.6;
}
