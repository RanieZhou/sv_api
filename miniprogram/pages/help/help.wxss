/* help.wxss */
.platform-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  background: #f0f9ff;
  color: #0284c7;
  border: 1rpx solid #bae6fd;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-weight: 500;
}

.step-number {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #38bdf8, #0284c7);
  color: #ffffff;
  font-weight: bold;
  font-size: 28rpx;
  flex-shrink: 0;
}

.step-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #0f172a;
  margin-bottom: 6rpx;
}

.step-desc {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
}
